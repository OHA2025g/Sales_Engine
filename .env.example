# AGRAYIAN Autonomous Revenue OS
APP_NAME=AGRAYIAN Autonomous Revenue OS
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14
DATABASE_URL=postgresql+psycopg://agrayian_app:agrayian@postgres:5432/agrayian
DATABASE_ADMIN_URL=postgresql+psycopg://agrayian:agrayian@postgres:5432/agrayian
REDIS_URL=redis://redis:6379/0
# Required before exposing /metrics. Leave empty in local mock.
METRICS_TOKEN=
ALLOW_PRODUCTION_SEED=false
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=agrayian
S3_SECRET_KEY=agrayiansecret
S3_BUCKET=agrayian
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=.object-storage
EMBEDDING_DIMENSIONS=32
KNOWLEDGE_MAX_BYTES=1000000
# PRODUCTION refuses unscanned uploads. Set MALWARE_SCANNER=clamav and CLAMAV_ENDPOINT for that host.
MALWARE_SCANNER=
CLAMAV_ENDPOINT=
WHATSAPP_PROVIDER=
GLOBAL_EMERGENCY_STOP=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LLM_PROVIDER=mock
# Live use: LLM_PROVIDER=gemini, then set the key and model ids.
# Chat and uploaded audio: gemini-3.6-flash. Embeddings: gemini-embedding-001 (re-ingest knowledge after switching).
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_STT_MODEL=
NEXT_PUBLIC_API_URL=http://localhost:8000
SEED_DEMO=true
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_MAX_ITEMS=10
APIFY_LINKEDIN_PROCESS_TOKEN=
DISCOVERY_PROVIDER=mock
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ADS_MODE=mock
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_SANDBOX_AD_ACCOUNT_ID=
META_ADS_MODE=mock
# Organic posts. Ads tokens do not publish to the feed.
# LinkedIn company posts need w_organization_social. Meta Page posts need a Page token.
LINKEDIN_POSTING_MODE=mock
LINKEDIN_POST_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Organic posts are live or mock. The ads sandbox does not apply to Page or Instagram posts.
META_POSTING_MODE=mock
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_URL=
VOICE_PROVIDER=mock
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
# Fernet key. Do not derive from SECRET_KEY in production. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
INTEGRATIONS_WEBHOOK_SECRET=
WEB_APP_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_IP_ALLOWLIST=
VOICE_CONVERSATION_PROVIDER=mock
NDNC_PROVIDER=local
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
MEETING_CAPTURE_PROVIDER=mock
ENRICHMENT_PROVIDER=mock
ENRICHMENT_API_KEY=
ENRICHMENT_API_BASE=
ML_MIN_ROWS=200
ML_MIN_POSITIVE=40
ML_MIN_NEGATIVE=40
ML_MIN_HISTORY_DAYS=90
ML_MAX_MISSINGNESS=0.30
ML_ALLOW_CHAMPION=false
