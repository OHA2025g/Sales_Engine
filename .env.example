# AGRAYIAN Autonomous Revenue OS
APP_NAME=AGRAYIAN Autonomous Revenue OS
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14
DATABASE_URL=postgresql+psycopg://agrayian_app:agrayian@postgres:5432/agrayian
DATABASE_ADMIN_URL=postgresql+psycopg://agrayian:agrayian@postgres:5432/agrayian
REDIS_URL=redis://redis:6379/0
# Required before exposing /metrics. Leave empty in local mock.
METRICS_TOKEN=
ALLOW_PRODUCTION_SEED=false
CORS_ORIGINS=http://localhost:3000
# Host ports when 3000/8000/6379/9000 are already taken (e.g. Dograh).
AGRAYIAN_WEB_PORT=3000
AGRAYIAN_API_PORT=8000
AGRAYIAN_POSTGRES_PORT=5432
AGRAYIAN_REDIS_PORT=6379
AGRAYIAN_MINIO_PORT=9000
AGRAYIAN_MINIO_CONSOLE_PORT=9001
COOKIE_SECURE=false
COOKIE_DOMAIN=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=agrayian
S3_SECRET_KEY=agrayiansecret
S3_BUCKET=agrayian
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=.object-storage
EMBEDDING_DIMENSIONS=32
KNOWLEDGE_MAX_BYTES=1000000
# PRODUCTION refuses unscanned uploads. Set MALWARE_SCANNER=clamav and CLAMAV_ENDPOINT for that host.
MALWARE_SCANNER=
CLAMAV_ENDPOINT=
WHATSAPP_PROVIDER=
GLOBAL_EMERGENCY_STOP=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LLM_PROVIDER=mock
# Live use: LLM_PROVIDER=gemini, then set the key and model ids.
# Chat and uploaded audio: gemini-3.6-flash. Embeddings: gemini-embedding-001 (re-ingest knowledge after switching).
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_STT_MODEL=
# Read when the web container starts. A rebuild is not required after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
SEED_DEMO=true
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_MAX_ITEMS=10
APIFY_LINKEDIN_PROCESS_TOKEN=
# Channel search. auto uses Programmable Search, then Apify, then Gemini. No source invents posts.
# GOOGLE_CSE_API_KEY and GOOGLE_CSE_CX return the top 10 Google results per channel.
# CHANNEL_SEARCH_PROVIDER=apify uses CHANNEL_SEARCH_APIFY_ACTOR and APIFY_API_TOKEN.
# CHANNEL_SEARCH_PROVIDER=gemini uses GEMINI_API_KEY and a configured Gemini model.
CHANNEL_SEARCH_PROVIDER=auto
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
CHANNEL_SEARCH_APIFY_ACTOR=apify/google-search-scraper
DISCOVERY_PROVIDER=mock
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ADS_MODE=mock
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_SANDBOX_AD_ACCOUNT_ID=
META_ADS_MODE=mock
# Organic posts. Ads tokens do not publish to the feed.
# LinkedIn company posts need w_organization_social. Meta Page posts need a Page token.
LINKEDIN_POSTING_MODE=mock
LINKEDIN_POST_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Organic posts are live or mock. The ads sandbox does not apply to Page or Instagram posts.
META_POSTING_MODE=mock
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_URL=
VOICE_PROVIDER=mock
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
# Fernet key. Do not derive from SECRET_KEY in production. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
INTEGRATIONS_WEBHOOK_SECRET=
WEB_APP_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_IP_ALLOWLIST=
VOICE_CONVERSATION_PROVIDER=mock
# Dograh places the call itself when this is dograh. Base, key, and the published agent UUID are all required.
DOGRAH_API_BASE=
DOGRAH_API_KEY=
DOGRAH_AGENT_UUID=
# In-browser Test Chat / Test Audio on Voice scripts. The API key cannot start those.
# In Dograh: Configure Widget, Headless, allow this website's domain. Paste the token= value.
# DOGRAH_UI_BASE is the Dograh website origin when it differs from DOGRAH_API_BASE.
DOGRAH_UI_BASE=
DOGRAH_EMBED_TOKEN=
DOGRAH_CHAT_EMBED_TOKEN=
# local when Dograh is running on this machine. Leave empty for production widgets.
DOGRAH_WIDGET_ENVIRONMENT=
# Optional full script URLs. When set, they replace the token fields above.
DOGRAH_VOICE_WIDGET_SRC=
DOGRAH_CHAT_WIDGET_SRC=
# Connect later. These channels stay unpublished until their credentials and providers are added.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
X_API_KEY=
X_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
NDNC_PROVIDER=local
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
MEETING_CAPTURE_PROVIDER=mock
ENRICHMENT_PROVIDER=mock
ENRICHMENT_API_KEY=
ENRICHMENT_API_BASE=
ML_MIN_ROWS=200
ML_MIN_POSITIVE=40
ML_MIN_NEGATIVE=40
ML_MIN_HISTORY_DAYS=90
ML_MAX_MISSINGNESS=0.30
ML_ALLOW_CHAMPION=false
